  "copy": {
    "intro": [
      "血液像身体里的流动小河。",
      "血液里有不同成员，它们有不同工作。"
    ],
    "keyFacts": [
      "红细胞像送氧气的小车。",
      "白细胞像身体里的守卫队。",
      "血小板像修路工，帮助伤口止血。",
      "血浆像河水，把大家带着一起流动。"
    ],
    "explainPrompt": "你能说出红细胞和白细胞的不同工作吗？"
  },
  "relatedTopics": [
    "immune-system",
    "heart",
    "digestion"
  ],
  "acceptanceCriteria": [
    "孩子能说出 3 种血液成员名称中的 2 种以上",
    "能说出红细胞和白细胞至少各 1 个功能",
    "页面不出现血腥、恐怖感"
  ],
  "status": "building",
  "renderPriority": 2,
  "hero": {
    "title": "血液里的小小工作队",
    "kicker": "身体世界 · 微观场景",
    "lead": "血液不是一杯红色的水，里面有很多小小成员在工作。",
    "sceneExplanation": "页面左侧是一个温和的血管微观通道：红细胞像扁扁的小圆盘在运输氧气，白细胞数量少但更大，像守护者；血小板更小，负责修补伤口；血浆像河水一样带着大家流动。",
    "childPrompt": "点一点每个小成员，看看它在身体里做什么工作。",
    "parentPrompt": "本页用‘工作队’比喻帮助孩子理解血液成分分工，避免血腥表现。",
    "placeholder": {
      "type": "microScene",
      "asset": "/assets/body/blood-cells-3d/hero-v01.png"
    }
  },
  "classificationGroups": [
    {
      "id": "red-blood-cells",
      "name": "红细胞",
      "childExplanation": "像送氧气的小车，把氧气送到身体各处。",
      "parentNote": "红细胞含有血红蛋白，儿童版先理解运输氧气即可。",
      "representativeObjects": [
        "red-cell"
      ],
      "misconception": "红细胞不是细菌，也不是普通红色水滴。"
    },
    {
      "id": "white-blood-cells",
      "name": "白细胞",
      "childExplanation": "像身体里的守卫，发现入侵者时会帮忙保护身体。",
      "parentNote": "不要展开复杂免疫分类，先理解防御功能。",
      "representativeObjects": [
        "white-cell"
      ],
      "misconception": "白细胞不是坏东西，它是身体的保护者。"
    },
    {
      "id": "platelets",
      "name": "血小板",
      "childExplanation": "像小小修补队，帮助伤口慢慢止血。",
      "parentNote": "可解释为参与凝血，不用讲凝血级联。",
      "representativeObjects": [
        "platelet"
      ],
      "misconception": "止血不是因为血液自己马上变硬，而是有修补过程。"
    },
    {
      "id": "plasma",
      "name": "血浆",
      "childExplanation": "像身体里的小河水，带着很多成员一起流动。",
      "parentNote": "血浆是液体部分，负责运输多种物质。",
      "representativeObjects": [
        "plasma"
      ],
      "misconception": "血液不只是细胞，也有液体部分。"
    }
  ],
  "representativeObjects": [
    {
      "id": "red-cell",
      "name": "红细胞",
      "groupId": "red-blood-cells",
      "childExplanation": "我负责送氧气。",
      "visualHint": "红色、扁圆、数量最多",
      "commonMisread": "以为所有红色小圆片功能都一样。"
    },
    {
      "id": "white-cell",
      "name": "白细胞",
      "groupId": "white-blood-cells",
      "childExplanation": "我负责保护身体。",
      "visualHint": "白色或淡色、比红细胞大、数量少",
      "commonMisread": "以为白细胞是入侵者。"
    },
    {
      "id": "platelet",
      "name": "血小板",
      "groupId": "platelets",
      "childExplanation": "我会帮忙修补小伤口。",
      "visualHint": "小小的碎片状或小圆点",
      "commonMisread": "以为它没有作用。"
    },
    {
      "id": "plasma",
      "name": "血浆",
      "groupId": "plasma",
      "childExplanation": "我带着大家一起流动。",
      "visualHint": "淡黄色或透明流动背景",
      "commonMisread": "忽略液体部分。"
    }
  ],
  "mechanism": {
    "title": "氧气怎么送到身体各处？",
    "steps": [
      {
        "id": "get-oxygen",
        "shortTitle": "肺部取氧",
        "childExplanation": "我们吸气时，氧气来到肺里。",
        "parentNote": "这里不展开肺泡结构，只说明氧气进入血液。"
      },
      {
        "id": "red-cell-load",
        "shortTitle": "红细胞装上氧气",
        "childExplanation": "红细胞带上氧气，准备出发。",
        "parentNote": "可补充红细胞里的血红蛋白帮助携带氧。"
      },
      {
        "id": "heart-pump",
        "shortTitle": "心脏推动",
        "childExplanation": "心脏像水泵，把血液推向全身。",
        "parentNote": "用水泵比喻即可，避免心脏结构过细。"
      },
      {
        "id": "deliver",
        "shortTitle": "送到身体",
        "childExplanation": "红细胞把氧气送给需要工作的地方。",
        "parentNote": "可举例肌肉、脑、手脚都需要氧气。"
      },
      {
        "id": "return",
        "shortTitle": "再带回废气",
        "childExplanation": "血液还会把身体产生的废气带回去。",
        "parentNote": "儿童版称为二氧化碳或废气均可。"
      }
    ]
  },
  "secondaryMechanism": {
    "title": "小伤口为什么会慢慢止血？",
    "steps": [
      {
        "id": "small-cut",
        "shortTitle": "出现小伤口",
        "childExplanation": "皮肤破了一个小口。",
        "parentNote": "画面要非常温和，不血腥。"
      },
      {
        "id": "platelets-arrive",
        "shortTitle": "血小板赶来",
        "childExplanation": "血小板像修补队一样聚过来。",
        "parentNote": "可说明它们参与形成堵住伤口的结构。"
      },
      {
        "id": "seal",
        "shortTitle": "帮助封住",
        "childExplanation": "小口慢慢被封住，血就少流了。",
        "parentNote": "不要表达为瞬间愈合。"
      }
    ]
  },
