  "mechanism": {
    "title": "分类时看什么线索？",
    "steps": [
      {
        "id": "look-body",
        "shortTitle": "先看身体",
        "childExplanation": "它有羽毛、鳞片、毛，还是 6 条腿？",
        "parentNote": "引导孩子先观察稳定特征。"
      },
      {
        "id": "look-life",
        "shortTitle": "再看生活方式",
        "childExplanation": "它住在水里、陆地，还是两边都能去？",
        "parentNote": "生活环境是辅助线索，不是唯一标准。"
      },
      {
        "id": "look-baby",
        "shortTitle": "看看宝宝",
        "childExplanation": "小时候怎么长大，也能帮助分类。",
        "parentNote": "哺乳、卵生、变态发育等可以后续扩展。"
      },
      {
        "id": "avoid-single-clue",
        "shortTitle": "不要只看一个线索",
        "childExplanation": "会飞不一定是鸟，住水里不一定是鱼。",
        "parentNote": "这是本页最重要的分类思维。"
      }
    ]
  },
