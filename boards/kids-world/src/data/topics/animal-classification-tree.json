  "copy": {
    "intro": [
      "动物世界很大，我们可以把它们分类。",
      "分类能帮助我们更好地认识世界。"
    ],
    "keyFacts": [
      "有些动物身体里有脊椎，叫脊椎动物。",
      "有些动物没有脊椎，叫无脊椎动物。",
      "哺乳类会用奶喂宝宝，鸟类有羽毛，鱼类用鳃呼吸。"
    ],
    "explainPrompt": "你能说出三个动物大类吗？"
  },
  "relatedTopics": [
    "insects-and-spiders",
    "dinosaurs",
    "ecosystem"
  ],
  "acceptanceCriteria": [
    "孩子能说出至少 3 个动物大类",
    "能纠正鲸鱼是鱼或蝙蝠是鸟中的至少 1 个误区",
    "树状结构清晰，不像成人生物分类表"
  ],
  "status": "building",
  "renderPriority": 1,
  "hero": {
    "title": "动物生命树",
    "kicker": "生命世界 · 分类任务",
    "lead": "动物世界像一棵大树。每个动物都住在自己的分支上。",
    "sceneExplanation": "页面左侧展示一棵分层生命树：树根是“动物”，第一层分成“有脊椎”和“无脊椎”，再向外分出哺乳类、鸟类、鱼类、爬行类、两栖类、昆虫等分支。孩子点击动物卡片时，对应分支发亮。",
    "childPrompt": "点一点动物卡，看看它应该住在哪根树枝上。",
    "parentPrompt": "本页重点不是背分类名，而是让孩子通过代表特征建立‘归类依据’：身体结构、呼吸方式、繁殖和生活方式。",
    "placeholder": {
      "type": "classificationTree",
      "asset": "/assets/life/animal-classification-tree/hero-v01.png"
    }
  },
  "classificationGroups": [
    {
      "id": "vertebrates",
      "name": "脊椎动物",
      "childExplanation": "身体里有一根重要的骨头柱子，像身体的支架。",
      "parentNote": "这里用儿童化语言解释脊柱，不必展开完整解剖学。",
      "representativeObjects": [
        "cat",
        "whale",
        "sparrow",
        "goldfish",
        "snake",
        "frog"
      ],
      "misconception": "不是所有生活在水里的动物都是鱼，鲸鱼也是脊椎动物，但它是哺乳类。"
    },
    {
      "id": "mammals",
      "name": "哺乳类",
      "childExplanation": "很多哺乳动物小时候会喝妈妈的奶，身上常常有毛。",
      "parentNote": "可提示鲸鱼和蝙蝠也是哺乳类，分类不能只看生活环境或会不会飞。",
      "representativeObjects": [
        "cat",
        "whale",
        "bat"
      ],
      "misconception": "鲸鱼不是鱼，蝙蝠不是鸟。"
    },
    {
      "id": "birds",
      "name": "鸟类",
      "childExplanation": "鸟类有羽毛，很多鸟会飞，也有一些鸟不太会飞。",
      "parentNote": "羽毛是鸟类更稳定的识别线索，会不会飞不是唯一标准。",
      "representativeObjects": [
        "sparrow",
        "penguin"
      ],
      "misconception": "会飞的不一定是鸟，比如蝙蝠。"
    },
    {
      "id": "fish",
      "name": "鱼类",
      "childExplanation": "鱼大多生活在水里，用鳃呼吸。",
      "parentNote": "鱼类概念可先用‘水里 + 鳃 + 鳍’帮助孩子识别。",
      "representativeObjects": [
        "goldfish",
        "shark"
      ],
      "misconception": "生活在水里不一定就是鱼，比如鲸鱼。"
    },
    {
      "id": "reptiles",
      "name": "爬行类",
      "childExplanation": "爬行类常常有鳞片，很多会贴近地面爬行。",
      "parentNote": "避免只用‘会爬’判断，乌龟、蛇、蜥蜴都可作为代表。",
      "representativeObjects": [
        "snake",
        "turtle"
      ],
      "misconception": "会爬的不一定都是爬行类。"
    },
    {
      "id": "amphibians",
      "name": "两栖类",
      "childExplanation": "两栖类小时候常在水里，长大后可以到陆地活动。",
      "parentNote": "青蛙是最佳代表，可用蝌蚪到青蛙的变化解释。",
      "representativeObjects": [
        "frog"
      ],
      "misconception": "青蛙不是爬行类。"
    },
    {
      "id": "insects",
      "name": "昆虫",
      "childExplanation": "昆虫通常有 6 条腿，身体分成几段。",
      "parentNote": "昆虫属于无脊椎动物。蜘蛛不是昆虫，可跳转到昆虫与蜘蛛页。",
      "representativeObjects": [
        "butterfly",
        "ant"
      ],
      "misconception": "蜘蛛不是昆虫。"
    }
  ],
