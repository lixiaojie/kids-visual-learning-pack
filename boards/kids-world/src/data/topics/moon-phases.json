  "copy": {
    "intro": [
      "月亮看起来会变脸。",
      "其实月亮没有真的变形，是我们看到的亮面在变化。"
    ],
    "keyFacts": [
      "太阳照亮月亮。",
      "月亮绕着地球运动。",
      "我们在地球上看到月亮亮的部分不同，就形成月相。"
    ],
    "explainPrompt": "你能用太阳、地球、月亮说一说为什么会有月相吗？"
  },
  "relatedTopics": [
    "solar-system-overview",
    "asteroid-belt",
    "earth-climate-cities"
  ],
  "acceptanceCriteria": [
    "孩子能说出月亮不是自己像太阳一样发光",
    "能识别至少 3 种月相",
    "能用“看到的亮面不同”解释月相"
  ],
