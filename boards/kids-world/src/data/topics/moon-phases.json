  "mechanism": {
    "title": "月相为什么会变化？",
    "steps": [
      {
        "id": "sunlight",
        "shortTitle": "太阳照亮",
        "childExplanation": "太阳照到月亮，总会照亮月亮的一部分。",
        "parentNote": "先建立光源。"
      },
      {
        "id": "moon-orbits",
        "shortTitle": "月亮绕地球",
        "childExplanation": "月亮一边绕着地球走，一边被太阳照亮。",
        "parentNote": "不讲精确周期，先讲运动关系。"
      },
      {
        "id": "viewer-on-earth",
        "shortTitle": "我们在地球看",
        "childExplanation": "我们站在地球上，只能看到月亮朝向我们的那一面。",
        "parentNote": "观察者视角是关键。"
      },
      {
        "id": "lit-part-changes",
        "shortTitle": "亮面多少不同",
        "childExplanation": "有时候看到一点亮面，有时候看到半边，有时候看到整面。",
        "parentNote": "用手电和球可以演示。"
      },
      {
        "id": "cycle-repeat",
        "shortTitle": "一轮又一轮",
        "childExplanation": "月相会按顺序变化，然后再重复。",
        "parentNote": "引出周期观察。"
      }
    ]
  },
  "secondaryMechanism": {
    "title": "怎么做月相观察？",
    "steps": [
      {
        "id": "same-time",
        "shortTitle": "固定时间看",
        "childExplanation": "每天差不多同一时间看看月亮。",
        "parentNote": "减少观察混乱。"
      },
      {
        "id": "draw-shape",
        "shortTitle": "画下形状",
        "childExplanation": "把看到的亮面形状画下来。",
        "parentNote": "可做亲子观察表。"
      },
      {
        "id": "compare-week",
        "shortTitle": "一周后比较",
        "childExplanation": "看看月亮是不是慢慢变了。",
        "parentNote": "把经验观察转成科学发现。"
      }
    ]
  },
