      "title": "找到机器人用来接收信息的传感器"
    },
    {
      "type": "sequence",
      "title": "按顺序说出机器人工作流程",
      "items": [
        "接收信息",
        "程序判断",
        "做出动作",
        "看结果再调整"
      ]
    },
    {
      "type": "explain",
      "title": "机器人为什么不是靠魔法动起来？"
    }
  ],
  "copy": {
    "intro": [
      "机器人不是靠魔法工作。",
      "它先接收信息，再按照程序判断，然后用轮子、灯光或机械臂行动。"
    ],
    "keyFacts": [
      "传感器帮助机器人接收外界信息。",
      "程序像任务规则，帮助机器人决定下一步。",
      "行动部件让机器人移动、发光、抓取或发出声音。"
    ],
    "explainPrompt": "你能说出一个机器人“看到—想一想—动起来”的过程吗？"
  },
  "relatedTopics": [
    "llm-kids-basics",
    "internet-message",
    "search-engine-kids"
  ],
  "acceptanceCriteria": [
    "孩子能说出输入、判断、行动三个环节",
    "能区分传感器和行动部件",
    "能用非魔法语言解释机器人工作"
  ],
  "status": "building",
  "renderPriority": 11,
  "hero": {
    "title": "机器人小工坊",
    "kicker": "人造系统世界 · 输入与行动",
    "lead": "机器人会先看见或听见，再按规则判断，最后做动作。",
    "sceneExplanation": "主视觉是友好的机器人工作台：左侧是摄像头、麦克风、按钮、距离传感器等输入，中央是程序判断云，右侧是灯光、轮子、机械臂等行动输出。",
    "childPrompt": "帮机器人找一找：它先接收到什么信息？然后做了什么动作？",
    "parentPrompt": "重点建立系统流程，不把机器人拟人化成“什么都懂”。",
    "placeholder": {
      "type": "systemFlow",
      "asset": "/assets/human-system/robots/human-system-robots-hero-v02.webp"
    }
  },
  "classificationGroups": [
    {
      "id": "sensors",
      "name": "接收信息",
      "childExplanation": "传感器像机器人的眼睛、耳朵和小按钮。",
      "parentNote": "用“接收信息”替代复杂硬件术语。",
      "representativeObjects": [
        "camera",
        "microphone",
        "button",
        "distance-sensor"
      ],
      "misconception": "机器人不用感知就知道外面发生什么。"
    },
    {
      "id": "controller",
      "name": "判断规则",
      "childExplanation": "程序告诉机器人遇到情况时该怎么做。",
      "parentNote": "可类比任务卡或交通规则。",
      "representativeObjects": [
        "program"
      ],
      "misconception": "机器人会自己随便想。"
    },
    {
      "id": "actuators",
      "name": "做出动作",
      "childExplanation": "轮子、灯和机械臂让机器人动起来或表达结果。",
      "parentNote": "行动部件也叫执行器，儿童版不用术语。",
      "representativeObjects": [
        "wheel",
        "light",
        "robot-arm"
      ],
      "misconception": "发光和转动都是同一种能力。"
    },
    {
      "id": "feedback",
      "name": "看结果再调整",
      "childExplanation": "机器人做完动作后，还可以再看看结果。",
      "parentNote": "引入反馈回路，和后续 AI/控制系统关联。",
      "representativeObjects": [
        "distance-sensor",
        "program"
      ],
      "misconception": "机器人只做一次动作，不会检查结果。"
    }
  ],
  "representativeObjects": [
    {
      "id": "camera",
      "name": "摄像头",
      "groupId": "sensors",
      "childExplanation": "摄像头可以帮助机器人看到图像。",
      "visualHint": "圆圆镜头",
      "commonMisread": "以为摄像头就是机器人的大脑。"
    },
    {
      "id": "microphone",
      "name": "麦克风",
      "groupId": "sensors",
      "childExplanation": "麦克风可以帮助机器人听到声音。",
      "visualHint": "小话筒",
      "commonMisread": "以为机器人不用设备就能听见。"
    },
    {
      "id": "button",
      "name": "按钮",
      "groupId": "sensors",
      "childExplanation": "按钮可以把人的选择告诉机器人。",
      "visualHint": "红色圆按钮",
      "commonMisread": "以为按钮是装饰。"
    },
    {
      "id": "distance-sensor",
      "name": "距离传感器",
      "groupId": "sensors",
      "childExplanation": "它可以帮机器人知道前面是不是太近了。",
      "visualHint": "两个小圆眼",
      "commonMisread": "以为它真的像眼睛一样看世界。"
    },
    {
      "id": "program",
      "name": "程序规则",
      "groupId": "controller",
      "childExplanation": "程序像任务规则，告诉机器人先做什么、后做什么。",
      "visualHint": "发光小脑云",
      "commonMisread": "以为程序就是魔法。"
    },
    {
      "id": "wheel",
      "name": "轮子",
      "groupId": "actuators",
      "childExplanation": "轮子让机器人前进、后退或转弯。",
      "visualHint": "黑色小轮胎",
      "commonMisread": "以为有轮子就一定是机器人。"
    },
    {
      "id": "light",
      "name": "灯光",
      "groupId": "actuators",
      "childExplanation": "灯光可以告诉我们机器人现在的状态。",
      "visualHint": "黄色发光灯",
      "commonMisread": "以为灯光只是好看。"
    },
    {
      "id": "robot-arm",
      "name": "机械臂",
      "groupId": "actuators",
      "childExplanation": "机械臂可以伸出去抓取或推动东西。",
      "visualHint": "有夹爪的小手臂",
      "commonMisread": "以为机械臂和人的手完全一样。"
    }
  ],
  "mechanism": {
    "title": "机器人怎样完成一个任务？",
    "steps": [
      {
        "id": "input",
        "shortTitle": "接收信息",
        "childExplanation": "摄像头、麦克风、按钮或传感器先接收到信息。",
        "parentNote": "对应 input。"
      },
      {
        "id": "interpret",
        "shortTitle": "看懂情况",
        "childExplanation": "机器人把信息交给程序，看看现在发生了什么。",
        "parentNote": "可简化为识别或判断。"
      },
      {
        "id": "decide",
        "shortTitle": "按规则决定",
        "childExplanation": "程序根据任务规则，决定下一步做什么。",
        "parentNote": "避免说机器人自己“想”。"
      },
      {
        "id": "act",
        "shortTitle": "做出动作",
        "childExplanation": "轮子、灯光或机械臂开始工作。",
        "parentNote": "对应 actuator / output。"
      },
      {
        "id": "feedback-loop",
        "shortTitle": "再检查",
        "childExplanation": "机器人可以再看看结果，必要时调整动作。",
        "parentNote": "引入反馈闭环。"
      }
    ]
  },
  "secondaryMechanism": {
    "title": "一个避障小例子",
    "steps": [
      {
        "id": "sense-wall",
        "shortTitle": "发现前面近",
        "childExplanation": "距离传感器发现前面有东西。",
        "parentNote": "连接传感器。"
      },
      {
        "id": "rule-stop",
        "shortTitle": "规则说停下",
        "childExplanation": "程序规则告诉机器人：太近就停下。",
        "parentNote": "连接程序。"
      },
      {
        "id": "wheel-stop",
        "shortTitle": "轮子停住",
        "childExplanation": "轮子停止转动，机器人不撞上去。",
        "parentNote": "连接执行器。"
      }
    ]
  },
