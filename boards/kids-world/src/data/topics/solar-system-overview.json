  "mechanism": {
    "title": "太阳系怎么排队？",
    "steps": [
      {
        "id": "center-sun",
        "shortTitle": "太阳在中心",
        "childExplanation": "太阳像太阳系的大灯塔，很多成员围着它转。",
        "parentNote": "此处强调引力中心，不展开公式。"
      },
      {
        "id": "orbits",
        "shortTitle": "行星沿轨道转",
        "childExplanation": "行星不是乱跑，而是沿着自己的轨道转。",
        "parentNote": "可说明轨道不是地面轨道，而是天体运动路径。"
      },
      {
        "id": "inner-planets",
        "shortTitle": "内侧岩石行星",
        "childExplanation": "水星、金星、地球、火星比较靠近太阳。",
        "parentNote": "先建立内外层结构。"
      },
      {
        "id": "asteroid-belt",
        "shortTitle": "中间有小行星带",
        "childExplanation": "火星和木星之间，有很多小天体。",
        "parentNote": "这是本页明确位置目标。"
      },
      {
        "id": "outer-planets",
        "shortTitle": "外侧巨行星",
        "childExplanation": "木星、土星、天王星、海王星在更外面。",
        "parentNote": "不需要记具体距离。"
      }
    ]
  },
