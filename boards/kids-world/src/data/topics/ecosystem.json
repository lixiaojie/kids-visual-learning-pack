  "mechanism": {
    "title": "生态系统怎样连接起来？",
    "steps": [
      {
        "id": "sun-to-plant",
        "shortTitle": "阳光给植物能量",
        "childExplanation": "植物利用阳光、水和空气生长。",
        "parentNote": "对应生产者。"
      },
      {
        "id": "plant-to-animal",
        "shortTitle": "植物养活动物",
        "childExplanation": "昆虫或其他动物会吃植物的一部分。",
        "parentNote": "强调能量从植物开始传递。"
      },
      {
        "id": "animal-to-animal",
        "shortTitle": "动物互相联系",
        "childExplanation": "青蛙、小鸟、狐狸等动物也会形成食物关系。",
        "parentNote": "避免血腥捕食，只讲依赖关系。"
      },
      {
        "id": "life-to-decomposer",
        "shortTitle": "落叶回到土里",
        "childExplanation": "落叶、枯枝会被蘑菇、蚯蚓和小微生物慢慢分解。",
        "parentNote": "分解者是核心。"
      },
      {
        "id": "nutrient-to-plant",
        "shortTitle": "养分再帮助植物",
        "childExplanation": "土壤里的养分又能帮助植物继续生长。",
        "parentNote": "形成循环而非单向链。"
      }
    ]
  },
  "secondaryMechanism": {
    "title": "环境也在参与",
    "steps": [
      {
        "id": "water-help",
        "shortTitle": "水帮助生命",
        "childExplanation": "植物和动物都需要水。",
        "parentNote": "连接水循环。"
      },
      {
        "id": "soil-home",
        "shortTitle": "土壤是家",
        "childExplanation": "植物扎根在土壤里，很多小生命也住在土里。",
        "parentNote": "建立栖息地概念。"
      },
      {
        "id": "change-affects",
        "shortTitle": "环境改变会影响生命",
        "childExplanation": "如果水变少或植物变少，很多动物都会受影响。",
        "parentNote": "引出系统性。"
      }
    ]
  },
