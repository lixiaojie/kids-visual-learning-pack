  "copy": {
    "intro": [
      "池塘边的植物、昆虫、青蛙、小鸟、蘑菇和土壤不是各过各的。",
      "它们像一张看不见的关系网，互相影响。"
    ],
    "keyFacts": [
      "植物利用阳光生长，是很多生命的食物来源。",
      "动物会吃植物或其他动物。",
      "蘑菇、细菌和蚯蚓等分解者帮助把落叶变成养分。",
      "水、阳光、空气和土壤也是生态系统的一部分。"
    ],
    "explainPrompt": "你能从阳光开始，说出池塘边一条生命联系路线吗？"
  },
  "relatedTopics": [
    "animal-classification-tree",
    "insects-and-spiders",
    "water-cycle",
    "dinosaurs"
  ],
  "acceptanceCriteria": [
    "孩子能说出生产者、消费者、分解者的基本区别",
    "能知道阳光、水、土壤也属于环境条件",
    "能用箭头讲出至少一条生态联系"
  ],
  "status": "building",
  "renderPriority": 12,
  "hero": {
    "title": "森林池塘生态网",
    "kicker": "生命世界 · 关系网络",
    "lead": "一片小池塘不是只有动物和植物，而是一张互相连接的生命网。",
    "sceneExplanation": "主视觉是温柔明亮的森林池塘：阳光照到植物，昆虫、青蛙、小鸟、狐狸、蘑菇、蚯蚓、水和土壤用少量箭头连接起来。",
    "childPrompt": "从太阳出发，找一条生命之间的连接路线。",
    "parentPrompt": "重点讲“联系”和“循环”，不要做复杂食物网。",
    "placeholder": {
      "type": "relationshipWeb",
      "asset": "/assets/life/ecosystem/life-ecosystem-hero-v02.webp"
    }
  },
  "classificationGroups": [
    {
      "id": "producers",
      "name": "生产者",
      "childExplanation": "植物用阳光、水和空气帮助自己生长。",
      "parentNote": "儿童版可说“自己制造食物的生命”。",
      "representativeObjects": [
        "sun",
        "plant"
      ],
      "misconception": "植物只是动物的背景。"
    },
    {
      "id": "consumers",
      "name": "消费者",
      "childExplanation": "动物需要吃植物或其他动物来获得能量。",
      "parentNote": "不渲染捕食，强调能量传递。",
      "representativeObjects": [
        "insect",
        "frog",
        "bird",
        "fox"
      ],
      "misconception": "动物之间只有打架关系。"
    },
