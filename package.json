{
  "name": "kids-visual-learning-pack",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-theme visual learning dashboards for kids and parent-child reading.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:static",
    "build:static": "bash scripts/build-static.sh",
    "build:edgeone": "npm run build:static",
    "build:kids-world": "vite build boards/kids-world --config vite.config.ts --base=./ --emptyOutDir --outDir ../../dist/kids-world",
    "build:paw": "vite build boards/paw-patrol --config vite.config.ts --base=./ --emptyOutDir --outDir ../../dist/paw-patrol",
    "check:images": "node scripts/check-image-assets.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:agent-infra": "bash scripts/ai/check-agent-infra.sh",
    "check:doc-governance": "bash scripts/ai/check-doc-governance.sh",
    "test:doc-governance": "bash scripts/ai/test-doc-governance.sh",
    "test:pre-commit": "bash scripts/ai/test-pre-commit.sh",
    "check:agent-state": "bash scripts/ai/check-agent-state.sh",
    "hooks:install": "bash scripts/ai/install-hooks.sh",
    "generate:site-meta": "node scripts/generate-site-meta.mjs",
    "images:import-prompts": "node scripts/import-kids-world-image-prompts.mjs",
    "images:import-generated-png": "node scripts/import-kids-world-generated-images.mjs",
    "inventory:card-os": "python3 scripts/card_os_asset_inventory.py --config migration/card-os/inventory-sources.json --roots migration/card-os/inventory-roots.local.json --output-root migration/card-os/generated",
    "test:card-os-inventory": "python3 -m unittest tests.test_card_os_asset_inventory -v",
    "test:card-os-deploy": "python3 -m unittest tests.test_card_os_backup tests.test_card_os_acceptance tests.test_card_os_deployment_assets tests.test_card_os_release -v",
    "build:card-os-release": "python3 ops/cognitive-card-server/build_release.py",
    "test:card-os-skill-registry": "python3 -m unittest tests.test_card_os_skill_release tests.test_card_os_skill_installer tests.test_card_os_skill_publisher tests.test_card_os_deployment_assets -v",
    "build:card-os-skill": "python3 ops/cognitive-card-skill/build_release.py",
    "test:visual-navigation": "node scripts/visual-navigation.test.mjs",
    "test:topic-interaction": "sucrase-node scripts/normalize-topic-interaction.test.ts",
    "test:scene-deck": "sucrase-node scripts/scene-deck.test.ts",
    "validate:scene-deck": "node scripts/validate-scene-deck.mjs",
    "validate:scene-ui": "node scripts/validate-scene-ui.mjs",
    "preview:kids-world": "vite preview --host 127.0.0.1 --outDir dist/boards/kids-world",
    "preview:paw": "vite preview --host 127.0.0.1 --outDir dist/paw-patrol",
    "deploy": "bash scripts/deploy.sh",
    "validate": "node scripts/validate-topics.mjs && node scripts/validate-i18n.mjs && node scripts/validate-assets.mjs && node scripts/validate-compliance.mjs && npm run validate:evidence && npm run test:visual-navigation && npm run validate:interaction-flow && npm run validate:evidence-focus && npm run validate:interaction-graph && npm run validate:scene-deck && npm run validate:scene-ui && npm run validate:kids-content && npm run validate:miniprogram && npm run validate:alignment",
    "validate:topics": "node scripts/validate-topics.mjs",
    "validate:i18n": "node scripts/validate-i18n.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:compliance": "node scripts/validate-compliance.mjs",
    "validate:evidence": "node scripts/validate-evidence-coverage.mjs",
    "validate:interaction-flow": "node scripts/validate-interaction-flow.mjs",
    "validate:evidence-focus": "node scripts/validate-evidence-focus.mjs",
    "validate:interaction-graph": "node scripts/validate-interaction-graph.test.mjs",
    "validate:kids-content": "./node_modules/.bin/tsc -p packages/kids-content/tsconfig.json --noEmit && node scripts/validate-kids-content-package.mjs && npm run test:topic-interaction",
    "validate:miniprogram": "node scripts/validate-miniprogram-scaffold.mjs",
    "validate:alignment": "node scripts/validate-content-alignment.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
